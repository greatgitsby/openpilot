  {"title": "Steering Limited: Rate [orange] Saturated [magenta]", "signals": ["steering rate limited", "/controlsState/lateralControlState/pidState/saturated"]}
], "equations": [
  {"name": "engaged curvature yaw", "source": "/carControl/angularVelocity/2", "additional": ["/carState/steeringPressed", "/carControl/enabled", "/carState/vEgo"], "globals": "engage_delay = 5\nlast_bad_time = -engage_delay", "function": "global last_bad_time\nif v1 == 1 or v2 == 0:\n  last_bad_time = time\nif time > last_bad_time + engage_delay:\n  return value / v3 if v3 != 0 else math.nan\nreturn 0"},
  {"name": "engaged curvature vehicle model", "source": "/controlsState/curvature", "additional": ["/carState/steeringPressed", "/carControl/enabled"], "globals": "engage_delay = 5\nlast_bad_time = -engage_delay", "function": "global last_bad_time\nif v1 == 1 or v2 == 0:\n  last_bad_time = time\nif time > last_bad_time + engage_delay:\n  return value\nreturn 0"},
  {"name": "engaged curvature plan", "source": "/modelV2/action/desiredCurvature", "additional": ["/carState/steeringPressed", "/carControl/enabled"], "globals": "engage_delay = 5\nlast_bad_time = -engage_delay", "function": "global last_bad_time\nif v1 == 1 or v2 == 0:\n  last_bad_time = time\nif time > last_bad_time + engage_delay:\n  return value\nreturn 0"},
  {"name": "engaged_accel_actual", "source": "/carState/aEgo", "additional": ["/carState/brakePressed", "/carState/gasPressed", "/carControl/enabled"], "globals": "engage_delay = 5\nlast_bad_time = -engage_delay", "function": "global last_bad_time\nif v1 != 0 or v2 != 0 or v3 == 0:\n  last_bad_time = time\nif time > last_bad_time + engage_delay:\n  return value\nreturn 0"},
  {"name": "engaged_accel_plan", "source": "/longitudinalPlan/accels/0", "additional": ["/carState/brakePressed", "/carState/gasPressed", "/carControl/enabled"], "globals": "engage_delay = 5\nlast_bad_time = -engage_delay", "function": "global last_bad_time\nif v1 != 0 or v2 != 0 or v3 == 0:\n  last_bad_time = time\nif time > last_bad_time + engage_delay:\n  return value\nreturn 0"},
  {"name": "engaged_accel_actuator", "source": "/carControl/actuators/accel", "additional": ["/carState/brakePressed", "/carState/gasPressed", "/carControl/enabled"], "globals": "engage_delay = 5\nlast_bad_time = -engage_delay", "function": "global last_bad_time\nif v1 != 0 or v2 != 0 or v3 == 0:\n  last_bad_time = time\nif time > last_bad_time + engage_delay:\n  return value\nreturn 0"},
  {"name": "steering rate limited", "source": "/carControl/actuators/torque", "additional": ["/carOutput/actuatorsOutput/torque", "/carControl/actuators/steeringAngleDeg", "/carOutput/actuatorsOutput/steeringAngleDeg"], "function": "return int(abs(value - v1) > 0.001 or abs(v2 - v3) > 0.05)"}
]}
