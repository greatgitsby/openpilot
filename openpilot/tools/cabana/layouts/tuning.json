      ],
      "globals_code": "engage_delay = 5\nlast_bad_time = -engage_delay",
      "function_code": "def sample(time, value, v1, v2, v3):\n  global engage_delay, last_bad_time\n  curvature = value / v3\n  pressed = v1\n  enabled = v2\n  if (pressed == 1 or enabled == 0):\n    last_bad_time = time\n  if (time > last_bad_time + engage_delay):\n    return curvature\n  else:\n    return 0\nreturn np.asarray([sample(*row) for row in zip(time, value, v1, v2, v3)])"
