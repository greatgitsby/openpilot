  {"signals": ["Actual lateral accel (roll compensated)", "Desired lateral accel (roll compensated)"]},
  {"signals": ["roll compensated lateral acceleration"]},
  {"signals": ["/carState/steeringPressed", "/carOutput/actuatorsOutput/torque"]},
  {"signals": [{"path": "/carState/vEgo", "scale": 2.23694}]}
], "equations": [
