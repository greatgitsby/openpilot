  {"name": "Desired lateral accel (roll compensated)", "source": "/controlsState/desiredCurvature", "additional": ["/carState/vEgo", "/vehicleParameters/roll"], "function": "return value * v1 ** 2 - v2 * 9.81"},
  {"name": "Actual lateral accel (roll compensated)", "source": "/controlsState/curvature", "additional": ["/carState/vEgo", "/vehicleParameters/roll"], "function": "return value * v1 ** 2 - v2 * 9.81"}
]}
