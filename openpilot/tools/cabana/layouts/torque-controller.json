        "/vehicleParameters/roll"
      ],
      "globals_code": "",
      "function_code": "def sample(time, value, v1, v2):\n  return (value * v1 ** 2) - (v2 * 9.81)\nreturn np.asarray([sample(*row) for row in zip(time, value, v1, v2)])"
    },
